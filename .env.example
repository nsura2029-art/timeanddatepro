# TimeAndDatePro environment variables
# Copy this to `.env` (or `.env.local`) and fill in the values you want to override.
# Everything has a safe default — only ADMIN_USER / ADMIN_PASS need to be set in production.

# ── Public REST API ──────────────────────────────────────────────────────
# Used for self-referential links, OAuth callbacks, sitemap origins.
# Default: https://timeanddatepro.com
PUBLIC_ORIGIN=https://timeanddatepro.com

# ── Admin panel ───────────────────────────────────────────────────────────
# Default user. If not set, "admin" is used.
ADMIN_USER=admin

# Default password. If NOT set, a random 18-char password is generated on first
# boot and written to ./.admin-credentials (mode 0600). Copy + rotate + delete
# the file after first login.
# ADMIN_PASS=change-me-on-first-login

# JWT signing secret. REQUIRED in production. Falls back to a dev-only constant
# in development which is unsafe to ship.
JWT_SECRET=replace-me-with-a-long-random-string

# SQLite file location. Default: ./data/tdp.db
# ADMIN_DB_PATH=/var/data/tdp.db

# ── Gemini AI (existing) ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Cloud Run / AI Studio ─────────────────────────────────────────────────
APP_URL=