{
  "info": {
    "name": "TimeAndDatePro Currency API",
    "description": "9 read-only endpoints for fiat + crypto rates, conversion, historical time series, and source health. All endpoints return { success, data } or { success: false, error }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://datetime-api-dev.nsura2029.workers.dev",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Currency Codes",
      "item": [
        {
          "name": "GET /currency/codes — List all supported currencies",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/codes", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "codes"] }
          }
        }
      ]
    },
    {
      "name": "2. Currency Rates",
      "item": [
        {
          "name": "GET /currency/rates?base=USD — All rates vs USD",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/rates?base=USD", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "rates"], "query": [{ "key": "base", "value": "USD" }] }
          }
        },
        {
          "name": "GET /currency/rates?base=EUR — All rates vs EUR",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/rates?base=EUR", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "rates"], "query": [{ "key": "base", "value": "EUR" }] }
          }
        },
        {
          "name": "GET /currency/rates (no base) — defaults to USD",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/rates", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "rates"] }
          }
        },
        {
          "name": "EDGE: invalid base (XX) → 400 invalid_base",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/rates?base=XX", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "rates"], "query": [{ "key": "base", "value": "XX" }] }
          }
        }
      ]
    },
    {
      "name": "3. Currency Convert",
      "item": [
        {
          "name": "GET /currency/convert?from=USD&to=EUR&amount=100",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/convert?from=USD&to=EUR&amount=100", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "convert"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }, { "key": "amount", "value": "100" }] }
          }
        },
        {
          "name": "EDGE: same currency → identity",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/convert?from=USD&to=USD&amount=100", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "convert"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "USD" }, { "key": "amount", "value": "100" }] }
          }
        },
        {
          "name": "EDGE: negative amount → 400 invalid_amount",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/convert?from=USD&to=EUR&amount=-5", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "convert"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }, { "key": "amount", "value": "-5" }] }
          }
        },
        {
          "name": "EDGE: missing amount → 400 missing_amount",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/convert?from=USD&to=EUR", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "convert"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }] }
          }
        },
        {
          "name": "EDGE: unknown currency → 400 invalid_from",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/convert?from=ZZZ&to=EUR&amount=100", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "convert"], "query": [{ "key": "from", "value": "ZZZ" }, { "key": "to", "value": "EUR" }, { "key": "amount", "value": "100" }] }
          }
        }
      ]
    },
    {
      "name": "4. Currency Pair",
      "item": [
        {
          "name": "GET /currency/pair?from=USD&to=EUR — rate + change + chart",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/pair?from=USD&to=EUR", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "pair"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }] }
          }
        },
        {
          "name": "EDGE: invalid codes → 400 invalid_codes",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/pair?from=XX&to=YY", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "pair"], "query": [{ "key": "from", "value": "XX" }, { "key": "to", "value": "YY" }] }
          }
        }
      ]
    },
    {
      "name": "5. Currency Timeseries",
      "item": [
        {
          "name": "GET /currency/timeseries?from=USD&to=EUR&start=2026-06-12&end=2026-07-10",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/timeseries?from=USD&to=EUR&start=2026-06-12&end=2026-07-10", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "timeseries"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }, { "key": "start", "value": "2026-06-12" }, { "key": "end", "value": "2026-07-10" }] }
          }
        },
        {
          "name": "EDGE: start > end → 400 start_after_end",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/timeseries?from=USD&to=EUR&start=2026-12-01&end=2026-01-01", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "timeseries"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }, { "key": "start", "value": "2026-12-01" }, { "key": "end", "value": "2026-01-01" }] }
          }
        },
        {
          "name": "EDGE: range > 5 years → 400 range_too_large",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/currency/timeseries?from=USD&to=EUR&start=2010-01-01&end=2026-01-01", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "timeseries"], "query": [{ "key": "from", "value": "USD" }, { "key": "to", "value": "EUR" }, { "key": "start", "value": "2010-01-01" }, { "key": "end", "value": "2026-01-01" }] }
          }
        }
      ]
    },
    {
      "name": "6. Currency Bulk",
      "item": [
        {
          "name": "POST /currency/bulk — convert multiple items",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"amount\": 100, \"from\": \"USD\", \"to\": \"EUR\" },\n    { \"amount\": 50, \"from\": \"EUR\", \"to\": \"USD\" },\n    { \"amount\": 1000, \"from\": \"USD\", \"to\": \"JPY\" }\n  ]\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/currency/bulk", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "bulk"] }
          }
        },
        {
          "name": "EDGE: empty items → 400 empty_items",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"items\": []}" },
            "url": { "raw": "{{baseUrl}}/api/v1/currency/bulk", "host": ["{{baseUrl}}"], "path": ["api", "v1", "currency", "bulk"] }
          }
        }
      ]
    },
    {
      "name": "7. Crypto Prices",
      "item": [
        {
          "name": "GET /crypto/prices?ids=bitcoin,ethereum&vs=usd",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/crypto/prices?ids=bitcoin,ethereum&vs=usd", "host": ["{{baseUrl}}"], "path": ["api", "v1", "crypto", "prices"], "query": [{ "key": "ids", "value": "bitcoin,ethereum" }, { "key": "vs", "value": "usd" }] }
          }
        },
        {
          "name": "EDGE: missing ids → 400 missing_ids",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/crypto/prices", "host": ["{{baseUrl}}"], "path": ["api", "v1", "crypto", "prices"] }
          }
        },
        {
          "name": "EDGE: all unknown ids → 400 all_unknown",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/crypto/prices?ids=fake,anotherfake", "host": ["{{baseUrl}}"], "path": ["api", "v1", "crypto", "prices"], "query": [{ "key": "ids", "value": "fake,anotherfake" }] }
          }
        }
      ]
    },
    {
      "name": "8. Crypto Convert",
      "item": [
        {
          "name": "GET /crypto/convert?from=BTC&to=USD&amount=1",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/crypto/convert?from=BTC&to=USD&amount=1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "crypto", "convert"], "query": [{ "key": "from", "value": "BTC" }, { "key": "to", "value": "USD" }, { "key": "amount", "value": "1" }] }
          }
        },
        {
          "name": "EDGE: negative amount → 400 invalid_amount",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/crypto/convert?from=BTC&to=USD&amount=-1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "crypto", "convert"], "query": [{ "key": "from", "value": "BTC" }, { "key": "to", "value": "USD" }, { "key": "amount", "value": "-1" }] }
          }
        }
      ]
    },
    {
      "name": "9. Status",
      "item": [
        {
          "name": "GET /status — all rate source health + audit",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/status", "host": ["{{baseUrl}}"], "path": ["api", "v1", "status"] }
          }
        }
      ]
    }
  ]
}
