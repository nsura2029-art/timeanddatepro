+  background: var(--color-brand-600);
+  color: #fff;
+  border-radius: var(--radius-sm);
+}
+.dtw-day-picker-wrap .rdp-day:hover:not(.rdp-day_disabled) {
+  background: var(--color-brand-50);
+  border-radius: var(--radius-sm);
+}
+.dtw-day-picker-wrap .rdp-day_today {
+  font-weight: 700;
+  color: var(--color-brand-700);
+}
+.dtw-day-picker-wrap .rdp-caption_label {
+  font-weight: 600;
+  color: var(--color-ink);
+}
+.dtw-day-picker-wrap .rdp-button_previous,
+.dtw-day-picker-wrap .rdp-button_next,
+.dtw-day-picker-wrap .rdp-dropdown_year,
+.dtw-day-picker-wrap .rdp-dropdown_month {
+  color: var(--color-ink-2);
+  font-family: inherit;
+  font-size: 13px;
+  border-radius: var(--radius-sm);
+}
+.dtw-day-picker-wrap .rdp-head_cell {
+  font-weight: 600;
+  font-size: 11px;
+  color: var(--color-muted);
