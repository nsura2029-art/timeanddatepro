+/* src/components/tools/DateToWord.css
+ * Premium SaaS treatment for the Date to Word tool. Pulls every
+ * value from src/styles/tokens.css so the look stays in sync with
+ * the hero. No glassy effects, no blur. White surface, soft
+ * shadows, NotebookLM pastel format tabs.
+ *
+ * Naming convention: dtw- prefix (Date To Words) so this file
+ * can be merged with the rest of the tool CSS without clashes.
+ */
+
+.dtw-main {
+  display: flex;
+  flex-direction: column;
+  gap: 0;
+}
+
+/* ── Hero ─────────────────────────────────────────────────── */
+.dtw-hero {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: end;
+  gap: 24px;
+  margin-bottom: 32px;
+  padding-top: 16px;
+}
+.dtw-hero-left { max-width: 720px; }
+.dtw-hero-right {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 6px;
+}
+
+.dtw-eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 4px 12px;
+  background: var(--color-mint);
+  border: 1px solid var(--color-mint-3);
+  border-radius: var(--radius-pill);
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--color-mint-ink);
+  margin-bottom: 16px;
+}
+.dtw-eyebrow-dot {
+  width: 6px;
+  height: 6px;
+  background: var(--color-emerald-500);
+  border-radius: 50%;
+  position: relative;
+}
+.dtw-eyebrow-dot::before {
+  content: "";
+  position: absolute;
+  inset: -3px;
+  border-radius: 50%;
+  background: var(--color-emerald-500);
+  opacity: 0.3;
+  animation: dtw-pulse 2s ease-in-out infinite;
+}
+@keyframes dtw-pulse {
+  0%, 100% { transform: scale(1); opacity: 0.3; }
+  50%      { transform: scale(1.5); opacity: 0; }
