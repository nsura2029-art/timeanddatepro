+              <span>Result</span>
+              <span className="dtw-output-fmt-tag">{selectedFormat}</span>
+            </div>
+            <div className="dtw-output-eyebrow-right">
+              <span className="dtw-output-locale-dot">●</span> {selectedLocale} · UTC-4
