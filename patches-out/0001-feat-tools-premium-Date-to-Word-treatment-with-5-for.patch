+
+.dtw-waitlist {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 6px 12px;
+  background: var(--color-info);
+  border: 1px solid var(--color-info-3);
+  border-radius: var(--radius-pill);
